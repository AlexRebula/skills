{
  "name": "@littlebranches/giselle-mui",
  "version": "0.1.0",
  "description": "MUI component library — accessible, theme-adaptive React components built on @mui/material with zero proprietary dependencies.",
  "license": "MIT",
  "author": "Alex Rebula",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js",
      "require": "./dist/motion.cjs"
    },
    "./lab": {
      "types": "./dist/lab.d.ts",
      "import": "./dist/lab.js",
      "require": "./dist/lab.cjs"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,cjs,mjs,ts}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,cjs,mjs,ts}\"",
    "fm:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,cjs,mjs,ts}\"",
    "fm:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,cjs,mjs,ts}\"",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:visual": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "node scripts/quality-gate/quality-gate/quality-gate.ts --fix",
    "check:verify": "node scripts/quality-gate/quality-gate/quality-gate.ts --verify",
    "check:verify:fast": "node scripts/quality-gate/quality-gate/quality-gate.ts --verify --smart --no-storybook",
    "check:verify:smart": "node scripts/quality-gate/quality-gate/quality-gate.ts --verify --smart --storybook",
    "check:verify:full": "node scripts/quality-gate/quality-gate/quality-gate.ts --verify --storybook",
    "generate:dod-docs": "node scripts/dod-docs/generate-dod-docs/generate-dod-docs.ts",
    "generate:dod-docs:check": "node scripts/dod-docs/generate-dod-docs/generate-dod-docs.ts --check",
    "preview:sync": "node scripts/preview-sync/preview-sync.ts",
    "clean": "rm -rf dist storybook-static",
    "postinstall": "node --input-type=module -e \"import('./scripts/setup-hooks/setup-hooks.js').catch((error)=>{const msg=String(error?.message??'');const isMissingSetupHooks=error?.code==='ERR_MODULE_NOT_FOUND'&&(msg.includes('scripts/setup-hooks/setup-hooks.js')||msg.includes('scripts\\\\setup-hooks\\\\setup-hooks.js'));if(!isMissingSetupHooks){console.error('Failed to run scripts/setup-hooks/setup-hooks.js during postinstall.');console.error(error);process.exitCode=1;}})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexRebula/giselle-mui.git"
  },
  "bugs": {
    "url": "https://github.com/AlexRebula/giselle-mui/issues"
  },
  "homepage": "https://github.com/AlexRebula/giselle-mui#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "keywords": [
    "react",
    "typescript",
    "mui",
    "material-ui",
    "component-library",
    "accessibility",
    "storybook"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@iconify/react": "^5.0.0 || ^6.0.0",
    "@mui/lab": "^7.0.0 || ^9.0.0-beta.3",
    "@mui/material": "^7.0.0 || ^9.0.0",
    "@mui/x-date-pickers": "^7.0.0 || ^9.0.0",
    "apexcharts": "^5.10.1",
    "dayjs": "^1.11.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "mui-one-time-password-input": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "apexcharts": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "react-apexcharts": {
      "optional": true
    },
    "@mui/lab": {
      "optional": true
    },
    "@mui/x-date-pickers": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "mui-one-time-password-input": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "minimal-shared": "^1.1.6",
    "react-phone-number-input": "^3.4.18"
  },
  "yalcSig": "7869fdc93dbf95054c2ed4a83d360118"
}
