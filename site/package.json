{
  "name": "alexrebula-skills-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "tsx ../scripts/generate-landing-data.ts && tsx ../scripts/generate-provenance.ts && tsx ../scripts/generate-skill-icons.ts",
    "start": "docusaurus start",
    "prebuild": "tsx ../scripts/generate-landing-data.ts && tsx ../scripts/generate-provenance.ts && tsx ../scripts/generate-skill-icons.ts && tsx ../scripts/check-docs-completeness.ts",
