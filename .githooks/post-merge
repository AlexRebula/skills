#!/usr/bin/env sh
# .githooks/post-merge
#
# When a merge or pull moves local `main` on, starts
# scripts/notify-consumers.ts in the background so every consumer listed in
# the local, gitignored notify-consumers.config.json refreshes its copy of
# this repo's site data. The pull doesn't wait for it: output goes to
# notify-consumers.log (gitignored) at the repo root, which keeps the
# latest run only.
#
# git runs post-merge for merges and merging pulls, not for
# `git pull --rebase` (or pull.rebase=true): after a rebasing pull, run
# npm run notify-consumers by hand.
#
# Does nothing on CI, on any branch other than main, or when the config
# file is missing. Run it by hand with: npm run notify-consumers
# Preview what it would do with:        npm run notify-consumers -- --dry-run

if [ -n "$CI" ]; then
  echo "notify-consumers: CI detected, skipping."
  exit 0
fi

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
[ "$branch" = "main" ] || exit 0

# Belt and braces: skip when ORIG_HEAD shows the merge didn't move HEAD.
# With no ORIG_HEAD at all, go ahead (git only runs this hook after a merge).
orig=$(git rev-parse --quiet --verify ORIG_HEAD 2>/dev/null)
[ -n "$orig" ] && [ "$orig" = "$(git rev-parse HEAD)" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 0

if [ ! -f "$root/notify-consumers.config.json" ]; then
  echo "notify-consumers: no notify-consumers.config.json, skipping (copy notify-consumers.config.example.json to set one up)."
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "notify-consumers: npm not found, skipping. Run by hand: npm run notify-consumers"
  exit 0
fi

# Detach fully: every fd of the background job is redirected, so git (and
# whatever is reading git's output) doesn't wait for it. Keep the `&` on a
# bare command, not on an `a && b` list: a backgrounded list forks a shell
# that still holds the hook's stdout/stderr open.
cd "$root" || exit 0
nohup npm run --silent notify-consumers >notify-consumers.log 2>&1 </dev/null &
echo "notify-consumers: started in the background, log: notify-consumers.log"
exit 0
