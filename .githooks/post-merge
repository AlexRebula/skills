#!/usr/bin/env sh
# .githooks/post-merge
#
# What it prints and when: see usage() below (or run it with --help).
#
# It runs no code at all, on purpose (no npm, no script from the pull); why
# is in scripts/notify-consumers.md, "When it runs".
#
# git runs post-merge for merges and merging pulls, not for
# `git pull --rebase` (or pull.rebase=true), so a rebasing pull prints
# nothing.
#
# Usage:
#   post-merge [<squash-flag>]   (git passes 1 for a squash merge, else 0)
#   post-merge --help
#
# Exit codes:
#   0  always: a hook that fails here can't undo the merge

set -eu

usage() {
  cat <<'HELP'
Usage: .githooks/post-merge [<squash-flag>]

Run by git after a merge. When local main moved on and
notify-consumers.config.json exists, prints the commands that show the
plan (npm run notify-consumers -- --dry-run) and start the run
(npm run notify-consumers). Runs nothing itself. On CI, or without the
config, says why and does nothing; off main, or when HEAD didn't move,
does nothing silently. Always exits 0.
HELP
}

say() {
  echo "notify-consumers: $*" >&2
}

main() {
  case "${1:-}" in
    -h | --help)
      usage
      return 0
      ;;
  esac

  if [ -n "${CI:-}" ]; then
    say "CI detected, skipping."
    return 0
  fi

  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  [ "$branch" = "main" ] || return 0

  # Belt and braces: skip when ORIG_HEAD shows the merge didn't move HEAD.
  # With no ORIG_HEAD at all, go ahead (git only runs this hook after a merge).
  orig=$(git rev-parse --quiet --verify ORIG_HEAD 2>/dev/null) || orig=""
  if [ -n "$orig" ] && [ "$orig" = "$(git rev-parse HEAD)" ]; then
    return 0
  fi

  root=$(git rev-parse --show-toplevel) || return 0

  if [ ! -f "$root/notify-consumers.config.json" ]; then
    say "not set up. Only needed if another project of yours keeps a copy of this repo's skills data; see scripts/notify-consumers.md."
    return 0
  fi

  say "this repo's main moved. See the plan: npm run notify-consumers -- --dry-run"
  say "run it: npm run notify-consumers"
}

main "$@"
