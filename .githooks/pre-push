#!/usr/bin/env sh
# .githooks/pre-push
#
# Runs the quality gate before every push: scripts/quality-gate.js, which
# covers root tests, the provenance script's lint, the docs site's full
# check (typecheck, lint, stylelint, tests), and the docs site build. Runs
# in smart mode locally (skips untriggered site/root-test steps based on
# the changed-file diff); CI always runs the full gate regardless. If any
# check fails the push is blocked: fix the issues and push again.
#
# To force the full gate locally: npm run check:verify:full
# To bypass in exceptional circumstances (use sparingly):
#   git push --no-verify

# Resolve node from PATH explicitly, needed on Windows where Git hooks
# run in a minimal shell that may not inherit the user's PATH.
NODE=$(command -v node 2>/dev/null || command -v node.exe 2>/dev/null)
if [ -z "$NODE" ]; then
  for candidate in \
    "$NVM_DIR/current/node.exe" \
    "$LOCALAPPDATA/fnm_multishells/*/node.exe" \
    "$APPDATA/nvm/current/node.exe" \
    "/c/Program Files/nodejs/node.exe"; do
    # shellcheck disable=SC2086
    for f in $candidate; do
      if [ -x "$f" ]; then NODE="$f"; break 2; fi
    done
  done
fi
if [ -z "$NODE" ]; then
  echo "pre-push: node not found, skipping quality gate. Install Node.js or run: npm run check:verify:smart"
  exit 0
fi

npm run check:verify:smart
